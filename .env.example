ENVIRONMENT=development

# Supabase: Project Settings -> Database -> Connection string -> URI
# Replace postgresql:// with postgresql+asyncpg:// so it works with SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Required — protects /restaurants endpoints (stopgap, not real auth; see
# app/core/security.py). Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Used starting Days 3-8 — leave empty for now
DEEPGRAM_API_KEY=
QWEN_API_KEY=
FISH_AUDIO_API_KEY=

# Days 11-12
SENTRY_DSN=
